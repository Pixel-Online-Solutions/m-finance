---
import "./HeroSlider.css";

const base = import.meta.env.BASE_URL;
---

<div class="hero-wrapper">
<section class="hero-banner" id="hero">
  <div
    class="banner-background"
    style={`background-image: url('${base}slider/slide1.jpg')`}
  >
    <div class="banner-overlay"></div>
    <div class="banner-content">
      <div class="banner-badge">
        <span>M-Finance Biuro Rachunkowe</span>
      </div>
      <h1 class="banner-title">Profesjonalne Biuro Rachunkowe</h1>
      <p class="banner-subtitle">Kompleksowa obsługa księgowa dla firm i klientów indywidualnych</p>
      <div class="banner-buttons">
        <a href={`${base}kontakt`} class="btn-accent btn-lg">
          Bezpłatna Konsultacja
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="#uslugi" class="btn-glass btn-lg">
          Poznaj Nasze Usługi
        </a>
      </div>
    </div>
  </div>
</section>
</div>

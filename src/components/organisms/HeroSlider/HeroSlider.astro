---
import "./HeroSlider.css";

const base = import.meta.env.BASE_URL;
---

<div class="hero-wrapper">
  <section class="hero-banner" id="hero">
  <div
    class="banner-background"
    style={`background-image: url('${base}slider/slide1.jpg')`}
  >
    <div class="banner-overlay"></div>
    <div class="banner-content">
      <h1 class="banner-title-minimal">Twój zaufany partner w prowadzeniu księgowości i rozliczeń podatkowych od 2017 roku.</h1>
      <div class="banner-buttons">
        <a href="#uslugi" class="btn-glass btn-lg">
          Poznaj Nasze Usługi
        </a>
      </div>
    </div>
  </div>
</section>
</div>

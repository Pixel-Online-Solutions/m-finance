---
import "./CTA.css";

interface Props {
  title?: string;
  description?: string;
  primaryButtonText?: string;
  primaryButtonHref?: string;
  secondaryButtonText?: string;
  secondaryButtonHref?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title = "Gotowy na profesjonalną obsługę księgową?",
  description = "Skontaktuj się z nami już dziś i przekonaj się, jak możemy pomóc w rozwoju Twojego biznesu. Pierwsza konsultacja jest bezpłatna!",
  primaryButtonText = "Umów Bezpłatną Konsultację",
  primaryButtonHref = `${base}kontakt`,
  secondaryButtonText = "Zadzwoń: 734 497 487",
  secondaryButtonHref = "tel:+48734497487"
} = Astro.props;
---

<section class="cta-section">
  <!-- Decorative floating shapes -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-10 left-10 w-72 h-72 bg-accent-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-white/5 rounded-full blur-3xl"></div>
  </div>

  <div class="cta-content">
    <div class="cta-card">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium mb-8 bg-white/10 border border-white/20">
        <svg class="w-5 h-5 mr-2 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Bezpłatna konsultacja
      </div>

      <h2 class="cta-title">{title}</h2>
      <p class="cta-description">{description}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={primaryButtonHref} class="btn-accent btn-lg group">
          {primaryButtonText}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href={secondaryButtonHref} class="btn-glass btn-lg group">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {secondaryButtonText}
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="flex flex-wrap items-center justify-center gap-8 mt-12 pt-8 border-t border-white/10">
        <div class="flex items-center gap-2 text-white/70 text-sm">
          <svg class="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Certyfikowane biuro
        </div>
        <div class="flex items-center gap-2 text-white/70 text-sm">
          <svg class="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          20+ lat doświadczenia
        </div>
        <div class="flex items-center gap-2 text-white/70 text-sm">
          <svg class="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          500+ zadowolonych klientów
        </div>
      </div>
    </div>
  </div>
</section>

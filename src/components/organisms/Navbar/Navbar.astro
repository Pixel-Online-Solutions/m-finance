---
import "./Navbar.css";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const base = import.meta.env.BASE_URL;

// Normalize currentPath to work with base URL
// currentPath comes as "/kontakt", we need to match it with "/m-finance/kontakt"
const normalizedCurrentPath = currentPath.startsWith('/') ? currentPath.slice(1) : currentPath;
const fullCurrentPath = base + normalizedCurrentPath;

const navLinks = [
  { href: `${base}`, label: "Strona Główna" },
  { href: `${base}o-nas`, label: "O Nas" },
  { href: `${base}klient-indywidualny`, label: "Klient Indywidualny" },
  { href: `${base}ksiegowosc-dla-firm`, label: "Księgowość dla Firm" },
  { href: `${base}kontakt`, label: "Kontakt" },
];
---

<header class="navbar" id="navbar">
  <div class="navbar-container">
    <!-- Left: Logo -->
    <a href={base} class="navbar-logo-link">
      <img src={`${base}logoraw.png`} alt="M-Finance" class="navbar-logo-img" />
    </a>

    <!-- Center: Desktop Navigation -->
    <nav class="navbar-menu flex-grow justify-center">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["navbar-link", { active: fullCurrentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: Mobile Menu -->
    <div class="flex items-center flex-shrink-0 ml-auto lg:ml-0">
      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 text-dark hover:text-primary-600 transition-colors"
        id="mobile-menu-btn"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-menu hidden" id="mobile-menu">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={["mobile-menu-link", { "text-primary-600": fullCurrentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<!-- Spacer to offset fixed navbar -->
<div class="h-0"></div>

<script>
  // Initialize everything when DOM is ready
  function initNavbar() {
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
      mobileMenuBtn.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');

        if (isOpen) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('open');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('open');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
      });
    }

    // Set light theme as default (no toggle)
    document.documentElement.setAttribute('data-theme', 'light');
  }

  // Run immediately if DOM is already loaded, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>

---
import "./WhyUs.css";

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  features?: { title: string; description: string }[];
  imageSrc?: string;
  imageAlt?: string;
  ctaText?: string;
  ctaHref?: string;
}

const base = import.meta.env.BASE_URL;

const {
  title = "Dlaczego M-Finance?",
  subtitle = "Certyfikowane biuro rachunkowe",
  description = "Biuro rachunkowe prowadzone przez Magdalenę Maciejak, działające na bazie certyfikatu księgowego nr 60945/2013 wydanego przez Ministra Finansów. Od 2015 roku wspieramy przedsiębiorców i osoby prywatne w prowadzeniu księgowości i rozliczeniach podatkowych.",
  features = [
    { title: "Od 2015 roku", description: "na rynku usług księgowych" },
    { title: "98% poleca", description: "wysoka ocena klientów" },
    { title: "Certyfikat MF", description: "nr 60945/2013" },
    { title: "Nagrody branżowe", description: "Orły Rachunkowości" }
  ],
  imageSrc = "https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=800&auto=format&fit=crop&q=80",
  imageAlt = "Biuro Rachunkowe M-Finance - Magdalena Maciejak",
  ctaText = "Poznaj naszą ofertę",
  ctaHref = `${base}o-nas`
} = Astro.props;
---

<section class="why-us-section" id="dlaczego-my">
  <!-- Decorative floating shapes -->
  <div class="floating-shapes">
    <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
    <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
    <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
  </div>

  <div class="container relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image -->
      <div class="relative rounded-3xl overflow-hidden dark-image-overlay">
        <img
          src={imageSrc}
          alt={imageAlt}
          loading="lazy"
          class="aspect-[4/3] object-cover"
        />
      </div>

      <!-- Content -->
      <div>
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          {subtitle}
        </span>
        <h2 class="heading-2 text-white mb-4">{title}</h2>
        <p class="text-primary-100 text-lg leading-relaxed mb-8">{description}</p>

        <!-- Features Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {features.map((feature) => (
            <div class="premium-glass-card">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0"
                     style="background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark));">
                  <svg class="w-6 h-6 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-white">{feature.title}</p>
                  {feature.title === "Nagrody branżowe" ? (
                    <p class="text-sm text-primary-200">
                      <a href="https://www.orlyrachunkowosci.pl/profile-31832-m-finance-biuro-rachunkowe-magdalena-maciejak"
                         target="_blank"
                         rel="noopener noreferrer"
                         class="hover:text-white transition-colors underline">
                        {feature.description}
                      </a>
                    </p>
                  ) : (
                    <p class="text-sm text-primary-200">{feature.description}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        {ctaHref && (
          <a href={ctaHref} class="btn-glass btn-lg group mt-8">
            {ctaText}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

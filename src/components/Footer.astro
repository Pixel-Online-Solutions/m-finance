---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: "/", label: "Strona Główna" },
  { href: "/o-nas", label: "O Nas" },
  { href: "/klient-indywidualny", label: "Klient Indywidualny" },
  { href: "/ksiegowosc-dla-firm", label: "Księgowość dla Firm" },
  { href: "/kontakt", label: "Kontakt" },
];

const services = [
  { href: "/ksiegowosc-dla-firm", label: "Pełna Księgowość" },
  { href: "/klient-indywidualny", label: "Rozliczenia PIT" },
  { href: "/ksiegowosc-dla-firm", label: "Obsługa Kadrowa" },
  { href: "/klient-indywidualny", label: "Zakładanie Firm" },
  { href: "/ksiegowosc-dla-firm", label: "Doradztwo Podatkowe" },
];
---

<footer class="footer">
  <div class="container">
    <!-- Top section with logo and newsletter -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-8 pb-12 mb-12 border-b border-white/10">
      <div>
        <a href="/" class="footer-logo">M-Finance</a>
        <p class="text-gray-light text-sm mt-2 max-w-md">
          Twój zaufany partner w prowadzeniu księgowości i rozliczeń podatkowych od 2017 roku.
        </p>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right hidden sm:block">
          <p class="text-white font-medium">Masz pytania?</p>
          <p class="text-gray-light text-sm">Skontaktuj się z nami</p>
        </div>
        <a href="/kontakt" class="btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Kontakt
        </a>
      </div>
    </div>

    <div class="footer-grid">
      <!-- Company Info -->
      <div>
        <h4 class="footer-title">O Nas</h4>
        <p class="footer-description">
          Profesjonalne biuro rachunkowe z wieloletnim doświadczeniem.
          Oferujemy kompleksową obsługę księgową dla firm i klientów indywidualnych.
        </p>
        <div class="footer-social mt-6">
          <a href="https://www.facebook.com/mfinance.mm/" target="_blank" rel="noopener" class="footer-social-link" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="mailto:m_finance@onet.pl" class="footer-social-link" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="footer-title">Nawigacja</h4>
        <nav class="footer-links">
          {quickLinks.map((link) => (
            <a href={link.href} class="footer-link">
              <svg class="w-4 h-4 opacity-0 -ml-4 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Services -->
      <div>
        <h4 class="footer-title">Usługi</h4>
        <nav class="footer-links">
          {services.map((service) => (
            <a href={service.href} class="footer-link">
              <svg class="w-4 h-4 opacity-0 -ml-4 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
              {service.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="footer-title">Kontakt</h4>
        <div class="space-y-5">
          <div class="footer-contact-item">
            <div class="footer-contact-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium text-sm">Adres biura</p>
              <a href="https://maps.app.goo.gl/iZcZ1Fb6d861URas7" target="_blank" rel="noopener" class="text-gray-light text-sm hover:text-white transition-colors">
                al. Jana Pawła II 13 lok 207<br>37-450 Stalowa Wola
              </a>
            </div>
          </div>
          <div class="footer-contact-item">
            <div class="footer-contact-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium text-sm mb-2">Telefon</p>
              <div class="space-y-1">
                <a href="tel:+48734497487" class="text-gray-light text-xs hover:text-white transition-colors block">
                  Centrala: +48 734 497 487
                </a>
                <a href="tel:+48735258693" class="text-gray-light text-xs hover:text-white transition-colors block">
                  Księgowość: +48 735 258 693
                </a>
                <a href="tel:+48735258694" class="text-gray-light text-xs hover:text-white transition-colors block">
                  Dział kadr: +48 735 258 694
                </a>
              </div>
            </div>
          </div>
          <div class="footer-contact-item">
            <div class="footer-contact-icon">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-white font-medium text-sm">Email</p>
              <a href="mailto:m_finance@onet.pl" class="text-gray-light text-sm hover:text-white transition-colors">
                m_finance@onet.pl
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; 2017-{currentYear} M-Finance Biuro Rachunkowe. Wszelkie prawa zastrzeżone.
      </p>
      <div class="flex items-center gap-6 text-sm text-gray-light">
        <a href="/polityka-prywatnosci" class="hover:text-white transition-colors">
          Polityka Prywatności
        </a>
        <a href="/regulamin" class="hover:text-white transition-colors">
          Regulamin
        </a>
      </div>
    </div>
  </div>
</footer>

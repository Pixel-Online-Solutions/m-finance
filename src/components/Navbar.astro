---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navLinks = [
  { href: "/", label: "Strona Główna" },
  { href: "/o-nas", label: "O Nas" },
  { href: "/klient-indywidualny", label: "Klient Indywidualny" },
  { href: "/ksiegowosc-dla-firm", label: "Księgowość dla Firm" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<header class="navbar" id="navbar">
  <div class="navbar-container">
    <!-- Logo -->
    <a href="/" class="navbar-logo">
      <span class="text-primary-600">M</span>-Finance
    </a>

    <!-- Desktop Navigation -->
    <nav class="navbar-menu">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["navbar-link", { active: currentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA Button (Desktop) -->
    <div class="hidden lg:flex items-center gap-4">
      <a href="tel:+48734497487" class="text-sm text-gray hover:text-primary-600 transition-colors">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          734 497 487
        </span>
      </a>
      <a href="/kontakt" class="btn-primary">
        Umów Spotkanie
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      class="lg:hidden p-2 text-dark hover:text-primary-600 transition-colors"
      id="mobile-menu-btn"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg class="w-6 h-6 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-menu hidden" id="mobile-menu">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={["mobile-menu-link", { "text-primary-600": currentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
    <div class="mt-6 space-y-4">
      <a href="tel:+48734497487" class="mobile-menu-link flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        734 497 487
      </a>
      <a href="/kontakt" class="btn-primary w-full text-center">
        Umów Spotkanie
      </a>
    </div>
  </div>
</header>

<!-- Spacer to offset fixed navbar -->
<div class="h-20"></div>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');

      if (isOpen) {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('open');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('open');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }
</script>

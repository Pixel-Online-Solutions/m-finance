---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const base = import.meta.env.BASE_URL;

// Normalize currentPath to work with base URL
// currentPath comes as "/kontakt", we need to match it with "/m-finance/kontakt"
const normalizedCurrentPath = currentPath.startsWith('/') ? currentPath.slice(1) : currentPath;
const fullCurrentPath = base + normalizedCurrentPath;

const navLinks = [
  { href: `${base}`, label: "Strona Główna" },
  { href: `${base}o-nas`, label: "O Nas" },
  { href: `${base}klient-indywidualny`, label: "Klient Indywidualny" },
  { href: `${base}ksiegowosc-dla-firm`, label: "Księgowość dla Firm" },
  { href: `${base}kontakt`, label: "Kontakt" },
];
---

<header class="navbar" id="navbar">
  <div class="navbar-container">
    <!-- Left: Logo -->
    <a href={base} class="flex items-center flex-shrink-0">
      <img src={`${base}logo.jpg`} alt="M-Finance" class="h-9 w-auto" />
    </a>

    <!-- Center: Desktop Navigation -->
    <nav class="navbar-menu flex-grow justify-center">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["navbar-link", { active: fullCurrentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right: Theme Toggle + Mobile Menu (grouped) -->
    <div class="flex items-center gap-2 flex-shrink-0 ml-auto lg:ml-0">
      <!-- Theme Toggle Button -->
      <button
        class="p-2 text-dark hover:text-primary-600 transition-colors"
        id="theme-toggle-btn"
        aria-label="Toggle theme"
        title="Przełącz motyw"
      >
        <!-- Sun icon (show in dark mode) -->
        <svg class="w-6 h-6" id="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <!-- Moon icon (show in light mode) -->
        <svg class="w-6 h-6 hidden" id="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden p-2 text-dark hover:text-primary-600 transition-colors"
        id="mobile-menu-btn"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-menu hidden" id="mobile-menu">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={["mobile-menu-link", { "text-primary-600": fullCurrentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<!-- Spacer to offset fixed navbar -->
<div class="h-0"></div>

<script>
  // Initialize everything when DOM is ready
  function initNavbar() {
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
      mobileMenuBtn.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');

        if (isOpen) {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('open');
          menuIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        } else {
          mobileMenu.classList.remove('hidden');
          mobileMenu.classList.add('open');
          menuIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
        }
      });
    }

    // Theme toggle functionality
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    // Get saved theme from localStorage or default to 'dark'
    function getTheme(): string {
      if (typeof localStorage !== 'undefined') {
        const savedTheme = localStorage.getItem('theme');
        return savedTheme || 'dark';
      }
      return 'dark';
    }

    // Set theme and update UI
    function setTheme(theme: string): void {
      document.documentElement.setAttribute('data-theme', theme);

      if (sunIcon && moonIcon) {
        if (theme === 'light') {
          sunIcon.classList.add('hidden');
          moonIcon.classList.remove('hidden');
        } else {
          sunIcon.classList.remove('hidden');
          moonIcon.classList.add('hidden');
        }
      }

      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('theme', theme);
      }
    }

    // Initialize theme immediately
    const currentTheme = getTheme();
    setTheme(currentTheme);

    // Toggle theme on button click
    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
      });
    }
  }

  // Run immediately if DOM is already loaded, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
</script>

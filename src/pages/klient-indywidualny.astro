---
import Layout from '@layouts/Layout.astro';
import '../components/organisms/WhyUs/WhyUs.css';
import '../components/organisms/HeroSlider/HeroSlider.css';
import '../components/organisms/Services/Services.css';

const base = import.meta.env.BASE_URL;
---

<Layout title="Klient indywidualny - M-Finance" currentPath="/klient-indywidualny">

  <div class="hero-wrapper">
    <section class="why-us-section" id="klient-indywidualny">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="heading-2 text-white mb-6">Klient indywidualny</h2>
        <p class="text-white/90 text-lg leading-relaxed">
          Sporządzanie rocznych rozliczeń PIT, Spadki i darowizny, Nieruchomości, VZM, Pomoc przy zakładaniu działalności gospodarczej, Bilanse i Biznesplany
        </p>
      </div>
    </div>
  </section>
  </div>

  <!-- Services Section - white cards on light background -->
  <section class="section-dark">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Card 1: Rozliczenia PIT -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Rozliczenia podatkowe PIT</h3>
          <p class="text-gray leading-relaxed mb-4">Profesjonalne przygotowanie i złożenie rocznych deklaracji podatkowych</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              PIT-37, PIT-36, PIT-28
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Ulgi podatkowe (dzieci, rehabilitacyjna, internet)
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Rozliczenie z małżonkiem lub osobno
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Dochody zagraniczne
            </li>
          </ul>
        </article>

        <!-- Card 2: Spadki i darowizny -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Spadki i darowizny</h3>
          <p class="text-gray leading-relaxed mb-4">Pomoc w rozliczeniach podatkowych związanych z nabyciem majątku</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Deklaracje SD-3, SD-Z2
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wycena majątku
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Zwolnienia podatkowe
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Doradztwo w zakresie grup podatkowych
            </li>
          </ul>
        </article>

        <!-- Card 3: Nieruchomości -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Nieruchomości</h3>
          <p class="text-gray leading-relaxed mb-4">Rozliczenia podatkowe związane ze sprzedażą i najmem nieruchomości</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Sprzedaż nieruchomości - obliczenie podatku
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Najem prywatny i komercyjny
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Zwolnienie z podatku - warunki
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Odliczenie kosztów i nakładów
            </li>
          </ul>
        </article>

        <!-- Card 4: Vademecum Życia Małżeńskiego (VZM) -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Vademecum Życia Małżeńskiego (VZM)</h3>
          <p class="text-gray leading-relaxed mb-4">Doradztwo podatkowe dla małżeństw i par</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wspólne vs oddzielne rozliczenia
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Planowanie podatkowe dla rodzin
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Optymalizacja obciążeń podatkowych
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Skutki podatkowe rozstania
            </li>
          </ul>
        </article>

        <!-- Card 5: Zakładanie działalności -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Zakładanie działalności gospodarczej</h3>
          <p class="text-gray leading-relaxed mb-4">Kompleksowa pomoc przy rozpoczęciu własnej firmy</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Przygotowanie dokumentów rejestracyjnych
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Doradztwo w wyborze formy opodatkowania
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Rejestracja w CEIDG, ZUS, US
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Konsultacje dotyczące ulg i zwolnień
            </li>
          </ul>
        </article>

        <!-- Card 6: Bilanse i biznesplany -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Bilanse i biznesplany</h3>
          <p class="text-gray leading-relaxed mb-4">Profesjonalne opracowanie dokumentacji finansowej</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Sporządzanie bilansów rocznych
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Przygotowanie biznesplanów
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Analizy finansowe dla inwestorów
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Dokumentacja na dotacje i kredyty
            </li>
          </ul>
        </article>

        <!-- Card 7: Wyjaśnienia podatkowe -->
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Sporządzanie wyjaśnień z zakresu zobowiązań podatkowych</h3>
          <p class="text-gray leading-relaxed mb-4">Profesjonalna pomoc w komunikacji z organami podatkowymi</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Odpowiedzi na wezwania urzędów skarbowych
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wyjaśnienia w sprawach zaległości podatkowych
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Pisma w postępowaniach wyjaśniających
            </li>
            <li class="flex items-start gap-2 text-sm text-gray">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Reprezentacja przed organami podatkowymi
            </li>
          </ul>
        </article>

      </div>
    </div>
  </section>

</Layout>

---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Klient indywidualny - M-Finance" currentPath="/klient-indywidualny">

  <!-- Hero Section -->
  <section class="section-dark min-h-[60vh] flex items-center">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-xs font-semibold uppercase tracking-wider text-primary-500 mb-4 block">
          Usługi dla osób fizycznych
        </span>
        <h1 class="heading-1 text-white mb-6">Klient indywidualny</h1>
        <p class="text-primary-200 text-xl leading-relaxed max-w-3xl mx-auto">
          Sporządzanie rocznych rozliczeń PIT, Spadki i darowizny, Nieruchomości, VZM,
          Pomoc przy zakładaniu działalności gospodarczej, Bilanse i Biznesplany
        </p>
      </div>
    </div>
  </section>

  <!-- Usługi Section -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="text-center mb-16">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Dla osób fizycznych
        </span>
        <h2 class="heading-2 text-white mb-4">Co oferujemy</h2>
        <p class="text-primary-100 text-lg max-w-2xl mx-auto">
          Dla osób fizycznych nie prowadzących działalności gospodarczej oferujemy pełen zakres usług księgowych i doradczych
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- Rozliczenia PIT -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Rozliczenia podatkowe PIT</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Sporządzanie rocznych rozliczeń podatkowych z dochodów osiąganych w Polsce i zagranicą
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              PIT-37 (umowy o pracę, emerytury, renty)
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              PIT-36 (działalność gospodarcza)
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              PIT-28 (podatek od przychodów kapitałowych)
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              PIT-38, PIT-39 (inne źródła dochodów)
            </li>
          </ul>
        </div>

        <!-- Spadki i darowizny -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Spadki i darowizny</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Profesjonalne rozliczanie spadków i darowizn zgodnie z obowiązującymi przepisami
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Deklaracje SD-Z2 (zgłoszenie nabycia rzeczy lub praw majątkowych)
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Deklaracje SD-3 (podatek od spadków i darowizn)
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Kalkulacja należnego podatku
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Doradztwo w zakresie ulg i zwolnień
            </li>
          </ul>
        </div>

        <!-- Nieruchomości -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Sprzedaż nieruchomości</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Analiza i rozliczanie sprzedaży nieruchomości z uwzględnieniem ulg i zwolnień
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Kalkulacja podatku od sprzedaży nieruchomości
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Weryfikacja ulgi mieszkaniowej
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Rozliczenie kosztów nabycia i ulepszenia
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Sporządzanie zeznania PIT-39
            </li>
          </ul>
        </div>

        <!-- VZM -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Wnioski VZM</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Przygotowanie wniosków o zwrot VAT od materiałów budowlanych
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Weryfikacja dokumentów i faktur
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Sporządzenie wniosku VZM
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Kalkulacja kwoty zwrotu
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Złożenie wniosku w urzędzie skarbowym
            </li>
          </ul>
        </div>

        <!-- Zakładanie działalności -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Zakładanie działalności</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Pomoc przy założeniu działalności gospodarczej - od wyboru formy po rejestrację
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Doradztwo w wyborze formy opodatkowania
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Przygotowanie dokumentów rejestracyjnych
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Rejestracja w CEIDG, ZUS, US
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wybór PKD i formy prawnej
            </li>
          </ul>
        </div>

        <!-- Bilanse i biznesplany -->
        <div class="premium-glass-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Bilanse i biznesplany</h3>
          <p class="text-primary-200 leading-relaxed mb-4">
            Pomoc przy sporządzaniu bilansów i biznesplanów przy rozpoczynaniu działalności
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Sporządzanie biznesplanów
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Przygotowanie prognoz finansowych
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Analiza opłacalności przedsięwzięcia
            </li>
            <li class="flex items-start gap-2 text-sm text-primary-200">
              <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Wsparcie w pozyskiwaniu dofinansowania
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Inne usługi Section -->
  <section class="section-dark">
    <div class="container">
      <div class="text-center mb-16">
        <span class="text-xs font-semibold uppercase tracking-wider text-primary-500 mb-4 block">
          Dodatkowe wsparcie
        </span>
        <h2 class="heading-2 text-white mb-4">Inne usługi</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="process-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4"
               style="background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark));">
            <svg class="w-7 h-7 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 text-center">Wyjaśnienia podatkowe</h3>
          <p class="text-primary-200 text-sm text-center">
            Sporządzanie wyjaśnień z zakresu zobowiązań podatkowych
          </p>
        </div>

        <div class="process-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4"
               style="background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark));">
            <svg class="w-7 h-7 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2 text-center">Doradztwo na bieżąco</h3>
          <p class="text-primary-200 text-sm text-center">
            Stałe wsparcie i odpowiedzi na pytania podatkowe
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Księgowość dla firm - M-Finance" currentPath="/ksiegowosc-dla-firm">

  <!-- Hero Section -->
  <section class="cta-section min-h-[60vh] flex items-center">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Kompleksowa obsługa firm
        </span>
        <h1 class="heading-1 text-white mb-6">Księgowość dla firm</h1>
        <p class="text-primary-100 text-xl leading-relaxed max-w-3xl mx-auto">
          Oferujemy pełen zakres usług księgowych dostosowanych do różnych form prowadzenia działalności.
          Od PKPiR, przez ryczałt, aż po pełne księgi rachunkowe i obsługę kadrowo-płacową.
        </p>
      </div>
    </div>
  </section>

  <!-- PKPiR Section -->
  <section class="section-dark">
    <div class="container">
      <div class="text-center mb-16">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent-400 mb-4 block">
          Najpopularniejsza forma księgowości
        </span>
        <h2 class="heading-2 text-white mb-4">Podatkowa Księga Przychodów i Rozchodów</h2>
        <p class="text-primary-200 text-lg max-w-2xl mx-auto">
          Kompleksowa obsługa księgowa dla firm prowadzących PKPiR
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Bieżąca ewidencja</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Ewidencjonowanie zdarzeń gospodarczych z optymalizacją rozliczeń podatkowych
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Deklaracje podatkowe</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Sporządzanie i składanie deklaracji PIT oraz VAT
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Ewidencja majątku</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Prowadzenie ewidencji środków trwałych i wyposażenia
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Reprezentacja</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Reprezentacja przed organami kontroli skarbowej
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Rozliczenia roczne</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Sporządzanie rozliczeń i sprawozdań rocznych
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Optymalizacja</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Doradztwo w zakresie optymalizacji podatkowej
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ryczałt i Karta Section -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-primary" style="top: 20%; right: 10%;"></div>
      <div class="floating-shape-accent" style="bottom: 20%; left: 10%;"></div>
    </div>

    <div class="container relative z-10">
      <div class="text-center mb-16">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          Uproszczone formy opodatkowania
        </span>
        <h2 class="heading-2 text-white mb-4">Ryczałt ewidencjonowany / Karta podatkowa</h2>
        <p class="text-primary-100 text-lg max-w-2xl mx-auto">
          Obsługa księgowa dla firm na ryczałcie lub karcie podatkowej
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="premium-glass-card">
          <h3 class="text-xl font-bold text-white mb-4">W ramach usług oferujemy:</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-primary-200">Bieżące prowadzenie ewidencji zakupu i sprzedaży dla potrzeb VAT</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-primary-200">Prowadzenie ewidencji środków trwałych i wyposażenia</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-primary-200">Sporządzanie deklaracji podatkowych z zakresu podatku dochodowego oraz VAT</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-primary-200">Reprezentacja Klienta przed organami kontroli skarbowej</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span class="text-primary-200">Sporządzanie rozliczeń i sprawozdań rocznych</span>
            </li>
          </ul>
        </div>

        <div class="premium-glass-card flex items-center justify-center">
          <div class="text-center">
            <div class="w-24 h-24 rounded-3xl flex items-center justify-center mx-auto mb-6"
                 style="background: linear-gradient(135deg, var(--color-accent-500), var(--color-accent-600));">
              <svg class="w-12 h-12 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3">Prosta i przejrzysta</h3>
            <p class="text-primary-200 text-lg">
              Forma księgowości dla małych firm
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Księgi Rachunkowe Section -->
  <section class="section-dark">
    <div class="container">
      <div class="text-center mb-16">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent-400 mb-4 block">
          Dla większych przedsiębiorstw
        </span>
        <h2 class="heading-2 text-white mb-4">Księgi rachunkowe</h2>
        <p class="text-primary-200 text-lg max-w-2xl mx-auto">
          Kompleksowa obsługa księgowa dla firm prowadzących pełną księgowość
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Sprawdzanie dokumentów</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Weryfikacja pod względem formalnym i rachunkowym oraz ewidencja operacji
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Ewidencja majątku</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Prowadzenie ewidencji środków trwałych i wyposażenia
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Bilanse i rachunki</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Sporządzanie bilansów i rachunków zysków i strat
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Deklaracje CIT i VAT</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Sporządzanie i składanie deklaracji CIT oraz VAT
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">INTRASTAT</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Sporządzanie deklaracji INTRASTAT dla handlu UE
          </p>
        </div>

        <div class="process-card">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 transition-all duration-300"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white mb-3 text-center">Reprezentacja</h3>
          <p class="text-primary-200 text-sm text-center leading-relaxed">
            Reprezentacja przed organami kontroli skarbowej i innymi urzędami
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kadry i Płace Section -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 15%; right: 15%;"></div>
      <div class="floating-shape-primary" style="bottom: 15%; left: 15%;"></div>
    </div>

    <div class="container relative z-10">
      <div class="text-center mb-16">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
          Zarządzanie personelem
        </span>
        <h2 class="heading-2 text-white mb-4">Obsługa kadrowo-płacowa</h2>
        <p class="text-primary-100 text-lg max-w-2xl mx-auto">
          Kompleksowa obsługa kadr i płac dla Twojej firmy
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-accent-500), var(--color-accent-600));">
            <svg class="w-7 h-7 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Dokumentacja kadrowa</h3>

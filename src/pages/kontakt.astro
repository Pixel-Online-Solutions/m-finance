---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt - M-Finance" currentPath="/kontakt">

  <!-- Hero Section -->
  <section class="section-dark min-h-[50vh] flex items-center">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-xs font-semibold uppercase tracking-wider text-accent-400 mb-4 block">
          Skontaktuj się z nami
        </span>
        <h1 class="heading-1 text-white mb-6">Kontakt</h1>
        <p class="text-primary-200 text-xl leading-relaxed max-w-3xl mx-auto">
          Zapraszamy do kontaktu. Chętnie odpowiemy na wszystkie pytania i pomożemy w wyborze najlepszego rozwiązania dla Twojej firmy.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info Section -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <!-- Telefon -->
        <div class="premium-glass-card text-center">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Telefon</h3>
          <a href="tel:+48734497487" class="text-accent-400 hover:text-accent-300 text-lg font-semibold transition-colors">
            734 497 487
          </a>
        </div>

        <!-- Email -->
        <div class="premium-glass-card text-center">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Email</h3>
          <a href="mailto:biuro@m-finance.pl" class="text-accent-400 hover:text-accent-300 text-lg font-semibold transition-colors">
            biuro@m-finance.pl
          </a>
        </div>

        <!-- Adres -->
        <div class="premium-glass-card text-center">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Adres</h3>
          <p class="text-primary-100 leading-relaxed">
            al. Jana Pawła II 13 lok 207<br>
            37-450 Stalowa Wola
          </p>
        </div>
      </div>

      <!-- Godziny otwarcia -->
      <div class="max-w-3xl mx-auto">
        <div class="premium-glass-card">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-white mb-2">Godziny otwarcia</h3>
            <p class="text-primary-200">Zapraszamy w godzinach:</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="text-center p-4 rounded-xl" style="background: rgba(255, 255, 255, 0.05);">
              <p class="text-white font-semibold mb-1">Poniedziałek - Piątek</p>
              <p class="text-accent-400 text-lg">8:00 - 16:00</p>
            </div>
            <div class="text-center p-4 rounded-xl" style="background: rgba(255, 255, 255, 0.05);">
              <p class="text-white font-semibold mb-1">Sobota - Niedziela</p>
              <p class="text-primary-300 text-lg">Zamknięte</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formularz kontaktowy -->
  <section class="section-dark">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-accent-400 mb-4 block">
            Napisz do nas
          </span>
          <h2 class="heading-2 text-white mb-4">Masz pytanie?</h2>
          <p class="text-primary-200 text-lg">
            Skorzystaj z naszego formularza kontaktowego
          </p>
        </div>

        <form class="space-y-6" action="#" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Imię i nazwisko / Firma -->
            <div>
              <label for="name" class="block text-sm font-semibold text-white mb-2">
                Imię i nazwisko / Firma *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl text-white placeholder-primary-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent-400"
                style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);"
                placeholder="Jan Kowalski / Firma XYZ"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-white mb-2">
                Adres e-mail *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl text-white placeholder-primary-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent-400"
                style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);"
                placeholder="jan@example.com"
              />
            </div>
          </div>

          <!-- Temat -->
          <div>
            <label for="subject" class="block text-sm font-semibold text-white mb-2">
              Temat wiadomości *
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 rounded-xl text-white placeholder-primary-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent-400"
              style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);"
              placeholder="W czym możemy pomóc?"
            />
          </div>

          <!-- Treść -->
          <div>
            <label for="message" class="block text-sm font-semibold text-white mb-2">
              Treść wiadomości *
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 rounded-xl text-white placeholder-primary-400 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-accent-400 resize-none"
              style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);"
              placeholder="Opisz swoją sprawę..."
            ></textarea>
          </div>

          <!-- Przycisk -->
          <div class="text-center">
            <button type="submit" class="btn-accent btn-lg group">
              Wyślij wiadomość
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <p class="text-primary-300 text-sm text-center">
            * Pola wymagane
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-primary" style="top: 20%; right: 10%;"></div>
      <div class="floating-shape-accent" style="bottom: 20%; left: 10%;"></div>
    </div>

    <div class="container relative z-10">
      <div class="text-center mb-12">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Nasze biuro
        </span>
        <h2 class="heading-2 text-white mb-4">Lokalizacja</h2>
        <p class="text-primary-100 text-lg">
          al. Jana Pawła II 13 lok 207, 37-450 Stalowa Wola
        </p>
      </div>

      <!-- Google Maps Embed -->
      <div class="max-w-5xl mx-auto rounded-3xl overflow-hidden" style="box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);">
        <div class="aspect-[16/9] bg-primary-900/50 flex items-center justify-center">
          <div class="text-center p-8">
            <svg class="w-16 h-16 text-primary-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-white text-lg font-semibold mb-2">Mapa Google</p>
            <p class="text-primary-200">
              al. Jana Pawła II 13 lok 207<br>
              37-450 Stalowa Wola
            </p>
            <a
              href="https://maps.app.goo.gl/iZcZ1Fb6d861URas7"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-4 text-accent-400 hover:text-accent-300 font-semibold transition-colors"
            >
              Otwórz w Google Maps
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-primary-100 mb-6">
          Zapraszamy do osobistego kontaktu w naszym biurze. Prosimy o wcześniejszy kontakt telefoniczny w celu umówienia terminu spotkania.
        </p>
        <a href="tel:+48734497487" class="btn-glass btn-lg group">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Zadzwoń: 734 497 487
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  input:focus,
  textarea:focus {
    background: rgba(255, 255, 255, 0.08) !important;
  }
</style>

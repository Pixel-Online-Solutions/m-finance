---
import Layout from '@layouts/Layout.astro';
import '../components/organisms/WhyUs/WhyUs.css';
import '../components/organisms/HeroSlider/HeroSlider.css';
import '../components/organisms/Services/Services.css';

const base = import.meta.env.BASE_URL;
---

<Layout title="Kontakt - M-Finance" currentPath="/kontakt">

  <div class="hero-wrapper">
    <section class="why-us-section hero-banner" id="kontakt" style="height: auto; min-height: auto; max-height: none;">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="heading-2 text-white mb-6">Kontakt</h2>
        <p class="text-white/90 text-lg leading-relaxed">
          Zapraszamy do kontaktu. Chętnie odpowiemy na wszystkie pytania i pomożemy w wyborze najlepszego rozwiązania dla Ciebie i Twojej firmy.
        </p>
      </div>
    </div>
  </section>
  </div>

  <!-- Contact Info Section - white cards on light background -->
  <section class="section-dark">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

        <!-- Telefon -->
        <article class="service-card text-center">
          <div class="service-card-icon mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Telefon</h3>
          <div class="space-y-3">
            <div>
              <p class="text-gray text-sm mb-1">Centrala</p>
              <a href="tel:+48734497487" class="text-primary-600 hover:text-primary-700 text-base font-semibold transition-colors block">
                +48 734 497 487
              </a>
            </div>
            <div>
              <p class="text-gray text-sm mb-1">Księgowość</p>
              <a href="tel:+48735258693" class="text-primary-600 hover:text-primary-700 text-base font-semibold transition-colors block">
                +48 735 258 693
              </a>
            </div>
            <div>
              <p class="text-gray text-sm mb-1">Dział kadr</p>
              <a href="tel:+48735258694" class="text-primary-600 hover:text-primary-700 text-base font-semibold transition-colors block">
                +48 735 258 694
              </a>
            </div>
          </div>
        </article>

        <!-- Email -->
        <article class="service-card text-center">
          <div class="service-card-icon mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Email</h3>
          <a href="mailto:m_finance@onet.pl" class="text-primary-600 hover:text-primary-700 text-lg font-semibold transition-colors">
            m_finance@onet.pl
          </a>
        </article>

        <!-- Adres -->
        <article class="service-card text-center">
          <div class="service-card-icon mx-auto">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Adres</h3>
          <p class="text-gray leading-relaxed mb-4">
            al. Jana Pawła II 13 lok 207<br>
            37-450 Stalowa Wola
          </p>
          <a href="https://maps.app.goo.gl/iZcZ1Fb6d861URas7" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold transition-colors text-sm">
            Otwórz w Google Maps
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </article>
      </div>

      <!-- Godziny otwarcia -->
      <div class="max-w-3xl mx-auto">
        <article class="service-card">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-dark mb-2">Godziny otwarcia</h3>
            <p class="text-gray">Zapraszamy w godzinach:</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="text-center p-4 rounded-xl bg-primary-50">
              <p class="text-dark font-semibold mb-1">Poniedziałek - Piątek</p>
              <p class="text-primary-600 text-lg font-bold">8:00 - 16:00</p>
            </div>
            <div class="text-center p-4 rounded-xl bg-gray-100">
              <p class="text-dark font-semibold mb-1">Sobota - Niedziela</p>
              <p class="text-gray text-lg">Zamknięte</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Formularz kontaktowy -->
  <section class="section-dark">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary-600 mb-4 block">
            Napisz do nas
          </span>
          <h2 class="heading-2 text-dark mb-4">Masz pytanie?</h2>
          <p class="text-gray text-lg">
            Skorzystaj z naszego formularza kontaktowego
          </p>
        </div>

        <form class="space-y-6 bg-white p-8 rounded-2xl shadow-lg" action="#" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Imię i nazwisko / Firma -->
            <div>
              <label for="name" class="block text-sm font-semibold text-dark mb-2">
                Imię i nazwisko / Firma *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 text-dark placeholder-gray-400 transition-all duration-300 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100"
                placeholder="Jan Kowalski / Firma XYZ"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-dark mb-2">
                Adres e-mail *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 text-dark placeholder-gray-400 transition-all duration-300 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100"
                placeholder="jan@example.com"
              />
            </div>
          </div>

          <!-- Temat -->
          <div>
            <label for="subject" class="block text-sm font-semibold text-dark mb-2">
              Temat wiadomości *
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 text-dark placeholder-gray-400 transition-all duration-300 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100"
              placeholder="W czym możemy pomóc?"
            />
          </div>

          <!-- Treść -->
          <div>
            <label for="message" class="block text-sm font-semibold text-dark mb-2">
              Treść wiadomości *
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 text-dark placeholder-gray-400 transition-all duration-300 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 resize-none"
              placeholder="Opisz swoją sprawę..."
            ></textarea>
          </div>

          <!-- Przycisk -->
          <div class="text-center">
            <button type="submit" class="btn-primary btn-lg group">
              Wyślij wiadomość
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </div>

          <p class="text-gray text-sm text-center">
            * Pola wymagane
          </p>
        </form>
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '@layouts/Layout.astro';
import '../components/organisms/WhyUs/WhyUs.css';
import '../components/organisms/HeroSlider/HeroSlider.css';
import '../components/organisms/Services/Services.css';

const base = import.meta.env.BASE_URL;
---

<Layout title="O nas - M-Finance" currentPath="/o-nas">

  <div class="hero-wrapper">
    <section class="why-us-section" id="o-nas">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="heading-2 text-white mb-6">O nas</h2>
        <p class="text-white/90 text-lg leading-relaxed">
          Naszym głównym celem jest odciążenie Klientów od wszelkich formalności związanych z prowadzeniem działalności gospodarczej, dając Państwu możliwość skoncentrowania się na swoim biznesie.
        </p>
      </div>
    </div>
  </section>
  </div>

  <!-- Features Section - white cards on light background -->
  <section class="section-dark">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <p class="service-card-description">
            Świadczymy usługi na podstawie certyfikatu księgowego nr 60945/2013 wydanego przez Ministra Finansów
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="service-card-description">
            Pomagamy w zakładaniu działalności gospodarczej (przygotowujemy niezbędne dokumenty, doradzamy w zakresie sposobu opodatkowania działalności)
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <p class="service-card-description">
            Reprezentujemy Klientów przed organami podatkowymi
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="service-card-description">
            Pracujemy na stabilnym systemie finansowo-księgowym CDN OPTIMA firmy COMARCH
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <p class="service-card-description">
            Gwarantujemy poufność danych finansowych i pracowniczych
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <p class="service-card-description">
            Na bieżąco śledzimy zmiany przepisów z zakresu prawa podatkowego, rachunkowości oraz prawa pracy
          </p>
        </article>

        <article class="service-card">
          <div class="service-card-icon">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <p class="service-card-description">
            Posiadamy polisę ubezpieczeniową OC jako gwarancję bezpieczeństwa świadczonych usług księgowych
          </p>
        </article>
      </div>
    </div>
  </section>

</Layout>

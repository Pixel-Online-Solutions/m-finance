---
import Layout from '@layouts/Layout.astro';
---

<Layout title="O nas - M-Finance" currentPath="/o-nas">

  <!-- Hero Section -->
  <section class="cta-section min-h-[60vh] flex items-center">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-accent" style="top: 10%; left: 10%;"></div>
      <div class="floating-shape-primary" style="bottom: 10%; right: 10%;"></div>
      <div class="floating-shape-white w-[600px] h-[600px]" style="top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
    </div>

    <div class="container relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Certyfikowane biuro rachunkowe
        </span>
        <h1 class="heading-1 text-white mb-6">O nas</h1>
        <p class="text-primary-100 text-xl leading-relaxed">
          Naszym głównym celem jest odciążenie Klientów od wszelkich formalności związanych
          z prowadzeniem działalności gospodarczej, dając Państwu możliwość skoncentrowania się na swoim biznesie.
        </p>
      </div>
    </div>
  </section>

  <!-- Certyfikat Section -->
  <section class="section-dark">
    <div class="container">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs font-semibold uppercase tracking-wider text-primary-500 mb-4 block">
            Profesjonalna obsługa
          </span>
          <h2 class="heading-2 text-white mb-4">Certyfikowane biuro rachunkowe</h2>
          <p class="text-primary-200 text-lg max-w-2xl mx-auto">
            Świadczymy usługi na podstawie certyfikatu księgowego nr 60945/2013 wydanego przez Ministra Finansów
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Certyfikat Card -->
          <div class="premium-glass-card">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0"
                   style="background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark));">
                <svg class="w-7 h-7 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">Certyfikat księgowy</h3>
                <p class="text-primary-200 text-sm leading-relaxed">
                  Nr 60945/2013 wydany przez Ministra Finansów
                </p>
              </div>
            </div>
          </div>

          <!-- Ubezpieczenie Card -->
          <div class="premium-glass-card">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0"
                   style="background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark));">
                <svg class="w-7 h-7 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">Ubezpieczenie OC</h3>
                <p class="text-primary-200 text-sm leading-relaxed">
                  Polisa ubezpieczeniowa jako gwarancja bezpieczeństwa świadczonych usług
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Co oferujemy Section -->
  <section class="cta-section">
    <!-- Decorative floating shapes -->
    <div class="floating-shapes">
      <div class="floating-shape-primary" style="top: 20%; right: 10%;"></div>
      <div class="floating-shape-accent" style="bottom: 20%; left: 10%;"></div>
    </div>

    <div class="container relative z-10">
      <div class="text-center mb-16">
        <span class="glass-badge mb-6">
          <svg class="w-5 h-5 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Nasze kompetencje
        </span>
        <h2 class="heading-2 text-white mb-4">Co nas wyróżnia</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <!-- Feature 1 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Reprezentacja przed urzędami</h3>
          <p class="text-primary-200 text-sm">
            Reprezentujemy Klientów przed organami podatkowymi
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Pomoc przy zakładaniu firm</h3>
          <p class="text-primary-200 text-sm">
            Pomagamy w zakładaniu działalności gospodarczej i doradztwie podatkowym
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Nowoczesne oprogramowanie</h3>
          <p class="text-primary-200 text-sm">
            Pracujemy na stabilnym systemie CDN OPTIMA firmy COMARCH
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Poufność danych</h3>
          <p class="text-primary-200 text-sm">
            Gwarantujemy pełną poufność danych finansowych i pracowniczych
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Aktualna wiedza</h3>
          <p class="text-primary-200 text-sm">
            Na bieżąco śledzimy zmiany przepisów podatkowych i rachunkowych
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="premium-glass-card">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary-700)); box-shadow: 0 10px 30px rgba(51, 176, 210, 0.3);">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Bezpieczeństwo usług</h3>
          <p class="text-primary-200 text-sm">
            Posiadamy polisę ubezpieczeniową OC dla świadczonych usług
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
